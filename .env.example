# =============================================================================
# NeedHelp — Variabel Lingkungan Supabase
# =============================================================================
# Salin file ini menjadi .env.local dan isi dengan nilai dari dashboard Supabase.
#
# CARA MENDAPATKAN NILAI:
# 1. Buka https://supabase.com/dashboard
# 2. Pilih proyek Anda (atau buat proyek baru)
# 3. Masuk ke Settings → API
# 4. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL
# 5. Salin "anon public" key ke NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# PERINGATAN:
# - JANGAN menggunakan service_role key di sini. Key itu hanya untuk server-side
#   dan bisa membocorkan seluruh data jika terekspos di browser.
# - File .env.local sudah ada di .gitignore dan tidak akan masuk Git.
# - Setelah mengubah .env.local, restart dev server (npm run dev).
# =============================================================================

# URL proyek Supabase (contoh: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Anon/public key Supabase (aman untuk digunakan di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
